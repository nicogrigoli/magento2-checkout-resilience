<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="checkout_resilience" translate="label" type="text" sortOrder="510" showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>Checkout Resilience</label>
            <tab>sales</tab>
            <resource>Grigoli_CheckoutResilience::checkout_resilience</resource>
            <group id="basic_settings" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Basic settings</label>
                <field id="enable" translate="label, comment" type="select" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Set 'Yes' for enable module in checkout</comment>
                </field>
            </group>
            <group id="failure_page_recovery" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Failure Page Recovery</label>
                <field id="enable" translate="label, comment" type="select" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable Failure Page Button</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Set 'Yes' to display the quote restoration button on the checkout failure page.</comment>
                </field>
                <field id="button_label" translate="label, comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Button Label</label>
                    <comment>Custom label for the quote restoration button on the checkout failure page.</comment>
                    <depends>
                        <field id="enable">1</field>
                    </depends>
                </field>
                <field id="redirect_destination" translate="label, comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Redirect Destination</label>
                    <source_model>Grigoli\CheckoutResilience\Model\Config\Source\RedirectDestination</source_model>
                    <comment>Select where customers are redirected after restoring their quote from the failure page.</comment>
                    <depends>
                        <field id="enable">1</field>
                    </depends>
                </field>
                <field id="custom_redirect_url" translate="label, comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Custom Redirect Path / URL</label>
                    <backend_model>Grigoli\CheckoutResilience\Model\Config\Backend\CustomRedirectUrl</backend_model>
                    <comment>Enter an internal relative path (e.g., checkout/cart or custom-recovery-page) or a URL matching the store's domain.</comment>
                    <depends>
                        <field id="enable">1</field>
                        <field id="redirect_destination">custom</field>
                    </depends>
                </field>
                <field id="enable_pre_failure_retries" translate="label, comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable Pre-Failure Retries</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Set 'Yes' to automatically intercept payment failures, restore the quote, and redirect to the payment step while retry attempts remain.</comment>
                </field>
                <field id="max_retry_attempts" translate="label, comment" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Max Retry Attempts</label>
                    <validate>validate-digits validate-zero-or-greater</validate>
                    <comment>Maximum number of pre-failure payment retry attempts before displaying the checkout failure page (0 disables interception).</comment>
                    <depends>
                        <field id="enable_pre_failure_retries">1</field>
                    </depends>
                </field>
                <field id="retry_notice_message" translate="label, comment" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Retry Notice Message</label>
                    <comment>Message displayed on the payment step after an intercepted failure. Use %1 as a placeholder for remaining attempts.</comment>
                    <depends>
                        <field id="enable_pre_failure_retries">1</field>
                    </depends>
                </field>
                <field id="cancel_previous_order" translate="label, comment" type="select" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Cancel Previous Pending Order on Quote Restore</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Set 'Yes' to automatically cancel open previous orders (pending / pending_payment) when a quote is restored, releasing inventory reservations. Disable for asynchronous payment gateways.</comment>
                </field>
            </group>
        </section>
    </system>
</config>