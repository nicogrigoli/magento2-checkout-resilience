<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <checkout_resilience>
            <basic_settings>
                <enable>0</enable>
            </basic_settings>
            <failure_page_recovery>
                <enable>0</enable>
                <button_label>Retry Payment</button_label>
                <redirect_destination>checkout/#payment</redirect_destination>
                <custom_redirect_url/>
                <enable_pre_failure_retries>0</enable_pre_failure_retries>
                <max_retry_attempts>3</max_retry_attempts>
                <retry_notice_message>Payment failed. Please try again (%1 attempts remaining).</retry_notice_message>
                <cancel_previous_order>1</cancel_previous_order>
            </failure_page_recovery>
        </checkout_resilience>
    </default>
</config>
