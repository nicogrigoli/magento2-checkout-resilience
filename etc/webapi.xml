<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <!-- Guest User Endpoint -->
    <route url="/V1/guest-carts/:cartId/resilience/restore" method="POST">
        <service class="Grigoli\CheckoutResilience\Api\GuestQuoteRestoreManagementInterface" method="execute"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

    <!-- Logged-In Customer Endpoint -->
    <route url="/V1/carts/mine/resilience/restore" method="POST">
        <service class="Grigoli\CheckoutResilience\Api\MineQuoteRestoreManagementInterface" method="execute"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
</routes>
